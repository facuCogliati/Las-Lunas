---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";

// Importamos todas las imágenes de la galería
import img1 from "../assets/galeria/1.jpg";
import img2 from "../assets/galeria/2.jpg";
import img3 from "../assets/galeria/3.jpg";
import img4 from "../assets/galeria/4.jpg";
import img5 from "../assets/galeria/5.jpg";
import img6 from "../assets/galeria/6.jpg";
import img7 from "../assets/galeria/7.jpg";
import img8 from "../assets/galeria/8.jpg";
import img9 from "../assets/galeria/9.jpg";
import img10 from "../assets/galeria/10.jpg";
import img11 from "../assets/galeria/11.jpg";
import img12 from "../assets/galeria/12.jpg";
import img13 from "../assets/galeria/13.jpg";
import img14 from "../assets/galeria/14.jpg";
import img15 from "../assets/galeria/15.jpg";
import img16 from "../assets/galeria/16.jpg";
import img17 from "../assets/galeria/17.jpg";
import img18 from "../assets/galeria/18.jpg";

const images = [
  img1,
  img2,
  img3,
  img4,
  img5,
  img6,
  img7,
  img8,
  img9,
  img10,
  img11,
  img12,
  img13,
  img14,
  img15,
  img16,
  img17,
  img18,
];
---

<Layout
  title="Galería de fotos | Las Lunas"
  description="Conocé nuestras instalaciones de 6000m² con fotos del predio, los animales y el equipo."
>
  <main class="page-galeria">
    <header class="gallery-header">
      <a href="/" class="header-back-btn">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span class="hide-on-mobile">Volver al inicio</span>
      </a>

      <svg
        class="gallery-paw header-paw-1 hide-on-mobile"
        viewBox="0 -2 60 45"
        aria-hidden="true"
      >
        <g fill="currentColor">
          <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse>
          <ellipse cx="26" cy="4" rx="4" ry="5"></ellipse>
          <ellipse cx="39" cy="6" rx="4" ry="5"></ellipse>
          <ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse>
          <ellipse cx="30" cy="28" rx="14" ry="13"></ellipse>
        </g>
      </svg>
      <svg
        class="gallery-paw header-paw-2 hide-on-mobile"
        viewBox="0 -2 60 45"
        aria-hidden="true"
      >
        <g fill="currentColor">
          <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse>
          <ellipse cx="26" cy="4" rx="4" ry="5"></ellipse>
          <ellipse cx="39" cy="6" rx="4" ry="5"></ellipse>
          <ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse>
          <ellipse cx="30" cy="28" rx="14" ry="13"></ellipse>
        </g>
      </svg>

      <div class="container">
        <div class="header-badge reveal">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>NUESTRO PREDIO</span>
        </div>

        <h1 class="reveal" style="transition-delay: 0.1s;">
          Así es <span class="text-accent">Las Lunas</span>
        </h1>

        <p class="lead-text reveal" style="transition-delay: 0.2s;">
          Más de 6.000 m² diseñados para el bienestar de tu mascota.<br
            class="hide-on-mobile"
          />
          Descubrí los espacios donde vienen a correr, jugar y descansar.
        </p>
      </div>
    </header>

    <section class="gallery-content">
      <div class="bg-paws-container">
        <svg class="bg-paw bg-paw-left" viewBox="0 0 60 45" aria-hidden="true"
          ><g fill="currentColor"
            ><ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
              cx="26"
              cy="4"
              rx="4"
              ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
            ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"
            ></ellipse><ellipse cx="30" cy="28" rx="14" ry="13"></ellipse></g
          ></svg
        >
        <svg class="bg-paw bg-paw-right" viewBox="0 0 60 45" aria-hidden="true"
          ><g fill="currentColor"
            ><ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
              cx="26"
              cy="4"
              rx="4"
              ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
            ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"
            ></ellipse><ellipse cx="30" cy="28" rx="14" ry="13"></ellipse></g
          ></svg
        >
      </div>

      <div class="container relative-z">
        <div class="gallery-carousel-wrapper">
          <div class="gallery-scroll" id="gallery-scroll">
            <div class="gallery-masonry" id="gallery-track">
              {
                images.map((img, i) => (
                  <button
                    type="button"
                    class="gallery-item reveal"
                    style={`transition-delay: ${0.05 * (i % 4)}s;`}
                    data-full-img={img.src}
                    aria-label={`Ampliar foto ${i + 1}`}
                  >
                    <div class="img-wrapper">
                      <img
                        src={img.src}
                        alt={`Las Lunas - foto de las instalaciones ${i + 1}`}
                        loading="lazy"
                        class="gallery-img"
                      />
                      <div class="hover-overlay">
                        <svg
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="11" cy="11" r="8" />
                          <line x1="21" y1="21" x2="16.65" y2="16.65" />
                          <line x1="11" y1="8" x2="11" y2="14" />
                          <line x1="8" y1="11" x2="14" y2="11" />
                        </svg>
                      </div>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="back-action reveal" style="transition-delay: 0.4s;">
          <a href="/" class="btn-outline"> ← Volver al inicio </a>
        </div>
      </div>
    </section>
  </main>

  <div id="gallery-lightbox" class="lightbox" aria-hidden="true">
    <button class="lightbox-close" aria-label="Cerrar">&times;</button>
    <img id="lightbox-image" src="" alt="Foto ampliada" />
  </div>

  <Footer />
</Layout>

<style>
  :root {
    --green: #95bc3a;
    --green-dark: #1b4332;
    --brown: #4a3f35;
    --white: #ffffff;
    --gray-light: #fbfbf9;
  }

  .page-galeria {
    background: var(--gray-light);
    min-height: 100vh;
  }

  /* --- HEADER --- */
  .gallery-header {
    background: var(--brown);
    color: var(--white);
    padding: 6rem 1rem 12rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* BOTÓN VOLVER ARRIBA IZQ */
  .header-back-btn {
    position: absolute;
    top: 2rem;
    left: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
    transition: all 0.3s ease;
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    padding: 10px 16px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .header-back-btn:hover {
    opacity: 1;
    background: var(--green);
    color: var(--brown);
    border-color: var(--green);
    transform: translateX(-3px);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: rgba(149, 188, 58, 0.15);
    border: 1px solid rgba(149, 188, 58, 0.3);
    border-radius: 50px;
    color: var(--green);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .gallery-header h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    color: var(--white);
    position: relative;
    z-index: 1;
  }

  .text-accent {
    color: var(--green);
  }

  .lead-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* --- PATITAS DECORATIVAS HEADER --- */
  .gallery-paw {
    position: absolute;
    height: auto;
    pointer-events: none;
    z-index: 0;
    color: var(--green);
    opacity: 0.15;
  }
  .header-paw-1 {
    top: 15%;
    left: 10%;
    transform: rotate(-15deg);
    width: 120px;
  }
  .header-paw-2 {
    top: 25%;
    right: 12%;
    transform: rotate(20deg);
    width: 100px;
  }

  /* --- CONTENIDO --- */
  .gallery-content {
    padding: 0 1rem 6rem;
    margin-top: -8rem;
    position: relative;
    z-index: 2;
  }

  .relative-z {
    position: relative;
    z-index: 3;
  }

  /* SVGs DECORATIVOS DE FONDO */
  .bg-paws-container {
    position: absolute;
    top: 8rem;
    left: 0;
    width: 100%;
    height: calc(100% - 8rem);
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .bg-paw {
    position: absolute;
    color: var(--green);
    opacity: 0.12;
  }
  .bg-paw-left {
    top: 5%;
    left: -2%;
    transform: rotate(-30deg) scale(3);
  }
  .bg-paw-right {
    top: 40%;
    right: -2%;
    transform: rotate(15deg) scale(4);
  }

  /* --- GRILLA MASONRY PURA (ESCRITORIO) --- */
  .gallery-masonry {
    column-count: 3;
    column-gap: 1.5rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  .gallery-item {
    display: inline-block;
    width: 100%;
    border: none;
    cursor: pointer;
    background: var(--white);
    border-radius: var(--radius-lg, 24px);
    padding: 8px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    margin-bottom: 1.5rem;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
  }

  .gallery-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.12);
  }

  .img-wrapper {
    width: 100%;
    border-radius: calc(var(--radius-lg, 24px) - 4px);
    overflow: hidden;
    position: relative;
  }

  .gallery-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.05);
  }

  .hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(74, 63, 53, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hover-overlay svg {
    color: var(--white);
    background: var(--green);
    border-radius: 50%;
    padding: 12px;
    width: 48px;
    height: 48px;
    transform: scale(0.5);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .gallery-item:hover .hover-overlay {
    opacity: 1;
  }
  .gallery-item:hover .hover-overlay svg {
    transform: scale(1);
  }

  /* --- LIGHTBOX --- */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    transform: scale(0.9);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .lightbox.active img {
    transform: scale(1);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: none;
    color: var(--white);
    font-size: 3.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 10px;
    z-index: 10000;
    transition: color 0.2s ease;
  }

  .lightbox-close:hover {
    color: var(--green);
  }

  /* --- BOTÓN VOLVER --- */
  .back-action {
    text-align: center;
    margin-top: 5rem;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.5rem;
    border: 2px solid var(--brown);
    color: var(--brown);
    border-radius: 50px;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-outline:hover {
    background: var(--brown);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(74, 63, 53, 0.15);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 1024px) {
    .gallery-masonry {
      column-count: 2;
    }
  }

  /* --- RESPONSIVE MOBILE OPTIMIZADO CON IMÁGENES CONTAIN --- */
  @media (max-width: 768px) {
    .gallery-header {
      padding: 4rem 1rem 5rem;
    }
    .gallery-header h1 {
      font-size: 1.8rem;
    }
    .lead-text {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .gallery-content {
      margin-top: -3rem;
      padding-bottom: 2rem;
    }

    /* Carousel full-width con swipe nativo */
    .gallery-carousel-wrapper {
      width: 100vw;
      left: 50%;
      transform: translateX(-50%);
      position: relative;
    }

    .gallery-scroll {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .gallery-scroll::-webkit-scrollbar {
      display: none;
    }

    .gallery-masonry {
      column-count: unset;
      display: flex;
      flex-direction: row;
      gap: 0;
      padding: 0;
      width: max-content;
    }

    .gallery-item {
      flex-shrink: 0;
      width: 100%; /* fallback — JS lo sobreescribe con el valor exacto */
      margin-bottom: 0;
      border-radius: 16px;
      overflow: hidden;
      padding: 0;
      background: transparent;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      scroll-snap-align: center;
    }

    .img-wrapper {
      width: 100%;
      border-radius: 16px;
      min-height: 220px;
      max-height: 62vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .gallery-img {
      width: 100%;
      min-height: 220px;
      max-height: 62vh;
      object-fit: contain;
      border-radius: 16px;
    }

    .hide-on-mobile {
      display: none;
    }

    .header-back-btn {
      top: 1rem;
      left: 1rem;
      padding: 8px;
    }

    .back-action {
      margin-top: 3rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryItems = document.querySelectorAll(".gallery-item");
    const lightbox = document.getElementById("gallery-lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-image",
    ) as HTMLImageElement;
    const closeBtn = document.querySelector(".lightbox-close");

    if (!lightbox) return;

    galleryItems.forEach((item) => {
      item.addEventListener("click", () => {
        const fullImgSrc = item.getAttribute("data-full-img");
        if (fullImgSrc && lightboxImg) {
          lightboxImg.src = fullImgSrc;
          lightbox.classList.add("active");
          document.body.style.overflow = "hidden";
        }
      });
    });

    const closeLightbox = () => {
      lightbox.classList.remove("active");
      document.body.style.overflow = "";
    };

    closeBtn?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox.classList.contains("active")) {
        closeLightbox();
      }
    });

    // Carousel con swipe nativo (solo mobile)
    if (window.innerWidth <= 768) {
      const gScroll = document.getElementById("gallery-scroll");
      const gTrack = document.getElementById(
        "gallery-track",
      ) as HTMLElement | null;

      if (gScroll && gTrack) {
        // Safari: sacar lazy loading — las imágenes en carousel se consideran off-screen
        gTrack.querySelectorAll("img").forEach((img) => {
          img.removeAttribute("loading");
        });

        // Doble RAF: espera que Safari calcule el layout antes de medir
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const itemW = gScroll!.clientWidth;
            gTrack!
              .querySelectorAll<HTMLElement>(".gallery-item")
              .forEach((el) => {
                el.style.width = itemW + "px";
              });
          });
        });
      }
    }
  });
</script>
