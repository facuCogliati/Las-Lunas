              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <span class="copyright">© 2026 Las Lunas.</span>
      <a
        href="/requisitos"
        target="_blank"
        rel="noopener"
        class="requisitos-link"
      >
        Requisitos sanitarios para ingresar al predio
      </a>
    </div>
  </div>
</footer>

<style>
  :root {
    --green: #95bc3a; /* Verde Claro Principal */
    --green-dark: #1b4332; /* Verde Oscuro Profundo */
    --white: #ffffff;
  }

  .footer {
    background: var(--white);
    color: var(--green-dark);
    padding-top: 2rem;
    position: relative;
    border-top: 1px solid rgba(45, 106, 79, 0.1);
  }

  /* --- CONTENIDO --- */
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0;
  }

  /* --- BRANDING (Círculo + Nombre) --- */
  .footer-brand {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-logo-circle {
    width: 60px;
    height: 60px;
    background: #f0fdf4;
    border: 1px solid rgba(45, 106, 79, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-shadow: 0 2px 8px rgba(45, 106, 79, 0.1);
    transition: transform 0.3s ease;
  }

  .footer-brand:hover .footer-logo-circle {
    transform: scale(1.05);
  }

  .footer-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .footer-brand-name {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--green);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* --- Navegación --- */
  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex: 1;
  }

  .footer-link {
    color: var(--green-dark);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    transition: color 0.2s ease;
    opacity: 0.85;
  }

  .footer-link:hover {
    color: var(--green);
    opacity: 1;
  }

  .footer-dot {
    color: var(--green);
    opacity: 0.5;
  }

  /* --- Redes Sociales y Mail --- */
  .footer-contact-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    flex: 1;
  }

  .footer-email-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--green-dark);
    opacity: 0.75;
    letter-spacing: 0.02em;
  }

  .footer-socials {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .social-icon:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.18);
  }

  /* Colores exactos de tu imagen */
  .mail-icon {
    background: var(--green);
  }
  .wa-icon {
    background: #25d366;
  }
  .ig-icon {
    background: linear-gradient(
      135deg,
      #f09433 0%,
      #e6683c 25%,
      #dc2743 50%,
      #cc2366 75%,
      #bc1888 100%
    );
  }

  /* --- Divisor y Bottom --- */
  .footer-divider {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(45, 106, 79, 0.15),
      transparent
    );
    margin: 1.5rem 0 1rem 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
  }

  .copyright {
    color: rgba(27, 67, 50, 0.45);
    font-size: 0.9rem;
  }

  .requisitos-link {
    font-size: 0.9rem;
    color: rgba(27, 67, 50, 0.55);
    text-decoration: underline;
    text-decoration-color: rgba(27, 67, 50, 0.2);
    text-underline-offset: 4px;
    transition: all 0.2s ease;
  }

  .requisitos-link:hover {
    color: var(--green);
    text-decoration-color: var(--green);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .footer-content {
      flex-direction: column;
      gap: 2.5rem;
      text-align: center;
    }

    .footer-brand,
    .footer-nav,
    .footer-contact-wrapper {
      flex: unset;
      align-items: center;
      justify-content: center;
    }

    .footer-brand {
      flex-direction: column;
      gap: 1rem;
    }

    .footer-socials {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding-top: 1.75rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }
    .social-icon {
      width: 52px;
      height: 52px;
    }
    .footer-socials {
      gap: 1rem;
    }
  }
</style>
