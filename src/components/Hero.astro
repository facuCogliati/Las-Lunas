---
import videoHero from "../assets/video servicios2.mp4";
---

<section id="inicio" class="hero">
  <video class="hero__video-bg" src={videoHero} autoplay muted loop playsinline
  ></video>

  <div class="hero__overlay"></div>

  <svg
    class="hero__deco hero__deco--desktop"
    viewBox="0 0 100% 100%"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <g class="paw" transform="translate(10vw, 20vh) rotate(-15) scale(1.2)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
    <g class="paw" transform="translate(85vw, 15vh) rotate(20) scale(1)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
    <g class="paw" transform="translate(80vw, 75vh) rotate(-30) scale(1.5)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
    <g class="paw" transform="translate(15vw, 80vh) rotate(10) scale(0.9)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
  </svg>

  <svg
    class="hero__deco hero__deco--mobile"
    viewBox="0 0 100% 100%"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <g class="paw" transform="translate(10vw, 15vh) rotate(-15) scale(0.7)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
    <g class="paw" transform="translate(80vw, 20vh) rotate(20) scale(0.6)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
    <g class="paw" transform="translate(70vw, 85vh) rotate(-10) scale(0.8)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse><ellipse
        cx="26"
        cy="4"
        rx="4"
        ry="5"></ellipse><ellipse cx="39" cy="6" rx="4" ry="5"
      ></ellipse><ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse><ellipse
        cx="30"
        cy="28"
        rx="14"
        ry="13"></ellipse>
    </g>
  </svg>

  <div class="container hero__content-wrapper">
    <div class="hero__content">
      <div class="hero__badge animate-up" style="animation-delay: 0.8s;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        Pilar, Buenos Aires
      </div>

      <div class="hero__eyebrow animate-up" style="animation-delay: 1s;">
        bienvenidos a
      </div>

      <h1 class="animate-up" style="animation-delay: 1.2s;">
        las<br />
        <span class="text-accent">lunas</span>
      </h1>

      <div class="hero__title-line animate-up" style="animation-delay: 1.4s;">
      </div>

      <p class="hero__sub animate-up" style="animation-delay: 1.6s;">
        Hospedaje profesional y seguro para tu mascota.<br />
        Acá vienen a correr, jugar, descansar y recibir cariño:<br />
        <em>Felicidad para ellos y tranquilidad para vos.</em>
      </p>

      <div class="hero__ctas animate-up" style="animation-delay: 1.8s;">
        <a href="#conocenos" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"
            ></path>
          </svg>
          Conocer más
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --green: #95bc3a; /* Tu color principal */
    --brown: #4a3f35; /* Tu color secundario */
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: calc(var(--pre-header-h) + var(--header-h));
    overflow: hidden;
  }

  /* ── VIDEO DE FONDO ── */
  .hero__video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  /* ── OVERLAY OSCURO NEUTRO (Libera el color real del video) ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    /* Negro al 55% de opacidad para que todo se lea sin perder las imágenes del video */
    background: rgba(0, 0, 0, 0.55);
    z-index: 1;
  }

  /* ── PATITAS DE FONDO ── */
  .hero__deco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .paw {
    fill: var(--white);
    opacity: 0.1; /* Super sutiles para no distraer */
  }

  .hero__deco--mobile {
    display: none;
  }
  .hero__deco--desktop {
    display: block;
  }

  /* ── CONTENEDOR PRINCIPAL CENTRADO ── */
  .hero__content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero__content {
    max-width: 800px;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ── ANIMACIONES DE ENTRADA ── */
  .animate-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── TEXTOS Y BOTONES ── */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 18px;
    /* Fondo semitransparente oscuro con borde blanco */
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero__eyebrow {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--green); /* Acabamos con el verde vibrante */
    margin-bottom: 0.5rem;
  }

  .hero__content h1 {
    font-size: clamp(4.5rem, 10vw, 9rem);
    color: var(--white);
    line-height: 1;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    font-weight: 900;
  }

  .text-accent {
    color: var(--green); /* El verde principal hace que resalte "lunas" */
  }

  .hero__title-line {
    width: 80px;
    height: 4px;
    background: var(--green);
    border-radius: 2px;
    margin-bottom: 2rem;
  }

  .hero__sub {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: rgba(
      255,
      255,
      255,
      0.9
    ); /* Blanco casi puro para lectura perfecta sobre el video oscuro */
    font-weight: 500;
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .hero__sub em {
    font-style: normal;
    font-weight: 800;
    color: var(--green); /* Detalles importantes en verde */
  }

  .hero__ctas {
    display: flex;
    justify-content: center;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 1.1rem 2.5rem;
    background: var(--green); /* Botón en el color principal */
    color: var(--brown); /* Letra en marrón para balancear la paleta */
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.3s,
      transform 0.3s,
      box-shadow 0.3s;
    box-shadow: 0 4px 20px rgba(149, 188, 58, 0.3);
  }

  .btn-primary svg {
    fill: var(--brown);
    flex-shrink: 0;
    transition: fill 0.3s;
  }

  .btn-primary:hover {
    background: var(--white);
    color: var(--green);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .btn-primary:hover svg {
    fill: var(--green);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 899px) {
    .hero__deco--desktop {
      display: none;
    }
    .hero__deco--mobile {
      display: block;
    }

    .hero__content h1 {
      font-size: clamp(4rem, 15vw, 6rem);
    }
  }
</style>
