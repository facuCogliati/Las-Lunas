---
import test2 from "../assets/testimonios/test2.jpg";
import test4 from "../assets/testimonios/test4.jpg";
import test5 from "../assets/testimonios/test5.jpg";
import test6 from "../assets/testimonios/test6.jpg";
import test7 from "../assets/testimonios/test7.jpg";
import test8 from "../assets/testimonios/test8.jpg";

const testimonios = [
  {
    texto:
      "Excelente lugar, hace años confiamos en Las Lunas para nuestro perro y gatos, siempre los atienden excelente desde el momento en que los vienen a buscar hasta que vuelven a casa. Nos envían fotos y nos cuentan cómo están. Hasta les festejan el cumpleaños. El perro sale corriendo y se sube solo a la camioneta, lo que demuestra que siempre tiene ganas de volver. ¡Gracias!",
    autor: "Adriana",
    año: "2002",
    mascotas: "Tchavolo, Sausalia y Dímiti",
    foto: null, // Sin foto, mostrará la inicial "A" en grande
  },
  {
    texto:
      "De verdad somos tan felices que tenemos a ustedes como un lugar de amor y cuidado cariñoso para Santi. Parece que él está extrañando su estadía en Las Lunas, a sus amiguitos, a ustedes. ¡Así que hasta pronto!",
    autor: "Ana Keinan",
    año: "2025",
    mascotas: "Santi",
    foto: test2.src,
  },
  {
    texto:
      "¡Espectacular todo! Muy cómodo el transfer y el baño la verdad. Y también los updates diarios del equipo nos encantó para quedarnos tranquilos. Hasta te diría que Duma volvió más tranquila. ¡Muy contentos, muchas gracias!",
    autor: "Victoria Angelillo",
    año: "2025",
    mascotas: "Duma",
    foto: null,
  },
  {
    texto:
      "Siroco es muy feliz en Las Lunas. Disfruta mucho de estar con otros perros y del cariño que le dan Rubén y su equipo. El lugar es impecable, limpio y amplio. Están súper cuidados, jugando en el jardín todo el día. ¡Los súper recomiendo!",
    autor: "Mora Lennon",
    año: "2015",
    mascotas: "Siroco",
    foto: test4.src,
  },
  {
    texto:
      "Hace 20 años los conocí llevando a Thor y lo trataban como propio hasta cuando estaba enfermo. Hoy en día cuidan a Slash y Kira y cuando los vienen a buscar ni dudan en irse con ellos. ¡Son los #1!",
    autor: "Nicolás Pereira",
    año: "2025",
    mascotas: "Thor, Slash y Kira",
    foto: test5.src,
  },
  {
    texto:
      "Los bombones ya están en casa y felices, muchas gracias por haberlos cuidado tan bien. Estamos muy contentos de haberlos encontrado. Por favor hacerle llegar nuestro agradecimiento a Rubén y a todos los que los colmaron de cuidados y mimos.",
    autor: "Miriam de Meyer",
    año: "2025",
    mascotas: "Los bombones",
    foto: test6.src,
  },
  {
    texto:
      "¡Gracias por todo! Realmente Fito volvió feliz. Hasta peinado, jajaja, nunca se había dejado cepillar. ¡Así que gracias de vuelta y estamos al habla para otras veces!",
    autor: "Sol Magliano",
    año: "2018",
    mascotas: "Fito",
    foto: test7.src,
  },
  {
    texto:
      "Mi perro Roque va hace 4 años, ya se siente parte del lugar. Los chicos del predio son súper dedicados y amables. ¡Los recomiendo sin dudas!",
    autor: "Verónica Roncorini",
    año: "2024",
    mascotas: "Roque",
    foto: test8.src,
  },
];
---

<section id="testimonios" class="section testimonios">
  <div class="container">
    <div class="testimonios__header reveal">
      <div class="header-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"
          ></path>
        </svg>
        <span>OPINIONES REALES</span>
      </div>
      <h2>TESTIMONIOS</h2>
    </div>

    <div
      class="testi-carousel reveal"
      id="testi-carousel"
      style="transition-delay: 0.1s;"
    >
      <div class="testi-viewport">
        <div class="testi-track" id="testi-track">
          {
            testimonios.map((t) => (
              <article class="testi-card">
                
                <!-- NUEVO: Columna de la Imagen Gigante -->
                <div class="testi-image-col">
                  {t.foto ? (
                    <img
                      src={t.foto}
                      alt={`Foto de la mascota de ${t.autor}`}
                      class="testi-large-img"
                    />
                  ) : (
                    <div class="testi-fallback-img">
                      {t.autor.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>

                <!-- Columna del Texto -->
                <div class="testi-text-col">
                  <div class="testi-quote">“</div>
                  <p class="testi-text">{t.texto}</p>
                  <div class="testi-author-info">
                    <strong class="testi-autor">{t.autor}</strong>
                    <span class="testi-meta">{t.año} - {t.mascotas}</span>
                  </div>
                </div>

              </article>
            ))
          }
        </div>
      </div>

      <div class="testi-nav">
        <button class="testi-btn" id="testi-prev" aria-label="Anterior">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <div class="testi-dots" id="testi-dots"></div>
        <button class="testi-btn" id="testi-next" aria-label="Siguiente">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonios {
    background: var(--green-dark); /* var(--green-dark, #1b4332) */
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .testimonios::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/assets/pattern-paws-light.svg");
    opacity: 0.03;
    pointer-events: none;
  }

  /* --- HEADER --- */
  .testimonios__header {
    text-align: center;
    margin-bottom: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: rgba(163, 230, 53, 0.1); 
    border-radius: 50px;
    color: var(--accent); /* var(--accent, #a3e635) */
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .testimonios__header h2 {
    color: var(--white);
    max-width: 600px;
  }

  /* --- CARRUSEL --- */
  .testi-carousel {
    position: relative;
    max-width: 1000px; /* Expandido para dar lugar a la foto grande */
    margin: 0 auto;
  }

  .testi-viewport {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .testi-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    width: 100%;
    align-items: stretch; 
  }

  /* --- TARJETA REDISEÑADA (Split Layout) --- */
  .testi-card {
    flex: 0 0 100%;
    width: 100%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    
    /* Layout tipo Grid para separar Foto de Texto */
    display: grid;
    grid-template-columns: 2fr 3fr; /* 40% Foto, 60% Texto */
    gap: 0; /* Sin espacio porque el padding lo maneja el texto */
    overflow: hidden; /* Para que la foto respete los bordes curvos de la tarjeta */
    box-sizing: border-box;
  }

  /* --- COLUMNA DE LA IMAGEN --- */
  .testi-image-col {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 350px;
    background: var(--accent);
  }

  .testi-large-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .testi-fallback-img {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8rem;
    font-family: var(--font-display);
    color: var(--green-dark);
    font-weight: 800;
  }

  /* --- COLUMNA DEL TEXTO --- */
  .testi-text-col {
    padding: 3rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .testi-quote {
    font-family: var(--font-display);
    font-size: 6rem;
    color: var(--accent);
    line-height: 1;
    margin-bottom: -1rem;
    margin-left: -0.5rem;
    opacity: 0.3;
  }

  .testi-text {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-style: italic;
    flex-grow: 1; /* Empuja el autor hacia abajo si hay espacio */
  }

  .testi-author-info {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
  }

  .testi-autor {
    display: block;
    color: var(--white);
    font-size: 1.15rem;
    margin-bottom: 4px;
  }

  .testi-meta {
    display: block;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* --- NAVEGACIÓN --- */
  .testi-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .testi-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition: all 0.3s ease;
  }

  .testi-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: scale(1.05);
    color: var(--accent);
  }

  .testi-dots {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  :global(.testi-dot) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  :global(.testi-dot.active) {
    background: var(--accent);
    transform: scale(1.3);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .testi-card {
      /* En tablets y celulares se apila: foto arriba, texto abajo */
      grid-template-columns: 1fr;
      grid-template-rows: 350px auto; 
    }
    .testi-text-col {
      padding: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .testimonios {
      padding: 5rem 0;
    }
    .testimonios__header {
      margin-bottom: 3.5rem;
    }
    .testi-card {
      grid-template-rows: 280px auto; /* Foto un poco más baja en celus */
    }
    .testi-text-col {
      padding: 2rem;
    }
    .testi-text {
      font-size: 1.05rem;
    }
    .testi-quote {
      font-size: 4rem;
    }
  }
</style>

<script>
  const track = document.getElementById("testi-track");
  const slides = document.querySelectorAll(".testi-card");
  const dotsEl = document.getElementById("testi-dots");
  const prevBtn = document.getElementById("testi-prev");
  const nextBtn = document.getElementById("testi-next");

  let cur = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function buildDots() {
    if (!dotsEl) return;
    slides.forEach((_, i) => {
      const d = document.createElement("button");
      d.className = `testi-dot ${i === 0 ? "active" : ""}`;
      d.setAttribute("aria-label", `Ir al testimonio ${i + 1}`);
      d.addEventListener("click", () => {
        cur = i;
        updateSlider();
        startAuto(); 
      });
      dotsEl.appendChild(d);
    });
  }

  function updateSlider() {
    if (!track || !dotsEl) return;
    track.style.transform = `translateX(-${cur * 100}%)`;
    dotsEl.querySelectorAll(".testi-dot").forEach((d, i) => {
      if (i === cur) d.classList.add("active");
      else d.classList.remove("active");
    });
    track.style.height = slides[cur].scrollHeight + "px";
  }

  function nextSlide() {
    cur = (cur + 1) % slides.length;
    updateSlider();
  }

  function prevSlide() {
    cur = (cur - 1 + slides.length) % slides.length;
    updateSlider();
  }

  function startAuto() {
    clearInterval(autoTimer);
    autoTimer = setInterval(nextSlide, 7000); 
  }

  if (track && slides.length > 0) {
    buildDots();
    updateSlider();
    startAuto();

    prevBtn?.addEventListener("click", () => {
      prevSlide();
      startAuto();
    });
    nextBtn?.addEventListener("click", () => {
      nextSlide();
      startAuto();
    });
  }
</script>