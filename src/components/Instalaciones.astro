---
import img1 from "../assets/instalaciones/1.jpg";
import img9 from "../assets/instalaciones/9.jpg";
import img10 from "../assets/instalaciones/10.jpg";

import img11 from "../assets/instalaciones/11.jpg"; // Arboleda y pileta
import img12 from "../assets/instalaciones/12.jpg"; // Gateras ambientadas
import img13 from "../assets/instalaciones/13.jpg"; // Zonas techadas

import fondo from "../assets/instalaciones/fondo3.jpg";
---

<section id="instalaciones" class="section instalaciones">
  <div class="inst__bg">
    <img src={fondo.src} alt="Fondo de parque verde" />
    <div class="inst__overlay"></div>
  </div>

  <div class="container Relative-z">
    <div class="inst__header reveal">
      <div class="inst__badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        NUESTRO PREDIO
      </div>
      <h2>Nuestras <span class="text-accent">Instalaciones</span></h2>
    </div>

    <div class="bento-wrapper">
      <div class="bento-scroll" id="bento-scroll">
        <div class="bento-grid reveal" style="transition-delay:0.1s">
          <article class="bento-item bento-item--large">
            <img src={img1.src} alt="Predio Las Lunas" loading="lazy" />
            <div class="bento-overlay">
              <h3>Predio 6.000 m² de área verde</h3>
            </div>
          </article>

          <article class="bento-item bento-item--wide">
            <img src={img11.src} alt="Arboleda y pileta" loading="lazy" />
            <div class="bento-overlay">
              <h3>Arboleda y pileta</h3>
            </div>
          </article>

          <article class="bento-item bento-item--square">
            <img src={img13.src} alt="Zonas techadas" loading="lazy" />
            <div class="bento-overlay">
              <h3>Zonas techadas</h3>
            </div>
          </article>

          <article class="bento-item bento-item--square">
            <img src={img12.src} alt="Gateras ambientadas" loading="lazy" />
            <div class="bento-overlay">
              <h3>Gateras ambientadas</h3>
            </div>
          </article>
        </div>
      </div>
    </div>

    <div class="location-wrapper reveal" style="transition-delay:0.2s">
      <div class="location-header">
        <span class="location-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path>
          </svg>
          Dónde encontrarnos
        </span>
      </div>

      <div class="loc-compact-grid">
        <div class="loc-compact-card">
          <img
            src={img10.src}
            alt="Predio en Pilar"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Predio en Pilar</h4>
            <a
              href="https://www.google.com/maps/place/las+lunas+hospedaje/@-34.4621712,-58.8166836,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bc99eed1e02425:0x3fffff070ad29f91!8m2!3d-34.4621712!4d-58.8166836!16s%2Fg%2F11j03_2tg3?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>

        <div class="loc-compact-card">
          <img
            src={img9.src}
            alt="Oficina atención al cliente"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Oficina atención al cliente</h4>
            <a
              href="https://www.google.com/maps/place/Las+Lunas+-+Oficina/@-34.4812534,-58.528356,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bcb1f12ef8f6d9:0xde855bf6d08d05bf!8m2!3d-34.4812534!4d-58.528356!16s%2Fg%2F11yt0tdlp7?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --green: #95bc3a; /* Verde Claro */
    --green-dark: #1b4332; /* Verde Oscuro */
    --brown: #4a3f35; /* Marrón Tierra */
    --white: #ffffff;
  }

  .instalaciones {
    padding: 6rem 0 7rem 0;
    position: relative;
    /* Evita que el fondo se salga de los límites de la sección */
    overflow: hidden;
  }

  /* ── FONDO DE IMAGEN Y OVERLAY ── */
  .inst__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .inst__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .inst__overlay {
    position: absolute;
    inset: 0;
    /* Degradado oscuro para garantizar legibilidad.
       Más opaco en los extremos, apenas más transparente en el medio */
    background: linear-gradient(
      to bottom,
      rgba(27, 67, 50, 0.75) 0%,
      rgba(27, 67, 50, 0.65) 40%,
      rgba(27, 67, 50, 0.75) 100%
    );
  }

  .Relative-z {
    position: relative;
    z-index: 1;
  }

  /* ── HEADER ── */
  .inst__header {
    margin-bottom: 3.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .inst__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    backdrop-filter: blur(5px);
  }

  .inst__header h2 {
    color: var(--white);
    margin-bottom: 0;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
  }
  .text-accent {
    color: var(--green);
  }

  /* ── BENTO GRID EDITORIAL ── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 280px);
    gap: 1.25rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  .bento-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.1); /* Toque sutil de marco */
  }

  .bento-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .bento-item--large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento-item--wide {
    grid-column: span 2;
    grid-row: span 1;
  }
  .bento-item--square {
    grid-column: span 1;
    grid-row: span 1;
  }

  .bento-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .bento-item:hover img {
    transform: scale(1.06);
  }

  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(27, 67, 50, 0.9) 0%,
      rgba(27, 67, 50, 0) 50%
    );
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .bento-overlay h3 {
    color: var(--white);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease;
  }

  .bento-item--large .bento-overlay h3 {
    font-size: 1.6rem;
  }

  .bento-item:hover .bento-overlay h3 {
    transform: translateY(-4px);
    color: var(--green);
  }

  /* ── SECCIÓN DE UBICACIÓN COMPACTA ── */
  .location-wrapper {
    max-width: 900px;
    margin: 4.5rem auto 0 auto;
    padding-top: 3.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.2);
  }

  .location-header {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .location-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--green);
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .loc-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .loc-compact-card {
    /* Efecto "Vidrio" (Glassmorphism) para que el fondo respire */
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .loc-compact-card:hover {
    transform: translateY(-3px);
    border-color: var(--green);
    background: rgba(255, 255, 255, 0.1);
  }

  .loc-compact-img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .loc-compact-info {
    display: flex;
    flex-direction: column;
  }

  .loc-compact-info h4 {
    color: var(--white);
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    line-height: 1.2;
  }

  .loc-link {
    color: var(--green);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-block;
  }

  .loc-link:hover {
    color: var(--white);
    transform: translateX(4px);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
    }

    .bento-item--large,
    .bento-item--wide,
    .bento-item--square {
      grid-column: span 1;
      grid-row: span 1;
      height: 250px;
    }

    .bento-item--large {
      grid-column: span 2;
      height: 350px;
    }

    .loc-compact-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .bento-scroll {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .bento-scroll::-webkit-scrollbar {
      display: none;
    }

    .bento-grid {
      display: flex;
      flex-direction: row;
      gap: 0;
      width: max-content;
    }

    .bento-item--large,
    .bento-item--wide,
    .bento-item--square {
      flex-shrink: 0;
      height: 260px;
      scroll-snap-align: center;
      /* width se setea por JS igual al ancho exacto del contenedor */
    }
  }
</style>

<script>
  const bentoScroll = document.getElementById("bento-scroll");
  const bentoGrid = bentoScroll?.querySelector(".bento-grid") as HTMLElement | null;

  if (bentoScroll && bentoGrid && window.innerWidth < 600) {
    // Doble RAF garantiza que el layout esté calculado antes de medir
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const itemWidth = bentoScroll!.clientWidth;
        const items = bentoGrid!.querySelectorAll<HTMLElement>(".bento-item");
        items.forEach((item) => { item.style.width = itemWidth + "px"; });
      });
    });
  }
</script>
