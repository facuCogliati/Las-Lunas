---
import img1 from "../assets/instalaciones/1.jpg";
import img2 from "../assets/instalaciones/2.jpg";
import img3 from "../assets/instalaciones/3.png";
import img4 from "../assets/instalaciones/4.png";
import img5 from "../assets/instalaciones/5.png";
import img6 from "../assets/instalaciones/6.png";
import img7 from "../assets/instalaciones/7.jpg";
import img8 from "../assets/instalaciones/8.jpg";
import img9 from "../assets/instalaciones/9.jpg";
import img10 from "../assets/instalaciones/10.jpg";

import img11 from "../assets/instalaciones/11.jpg"; // Arboleda y pileta
import img12 from "../assets/instalaciones/12.jpg"; // Gateras ambientadas
import img13 from "../assets/instalaciones/13.jpg"; // Zonas techadas
---

<section id="instalaciones" class="section instalaciones">
  <div class="container Relative-z">
    <div class="inst__header reveal">
      <div class="inst__badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        NUESTRO PREDIO
      </div>
      <h2>Nuestras <span class="text-accent">Instalaciones</span></h2>
    </div>

    <div class="bento-grid reveal" style="transition-delay:0.1s">
      <article class="bento-item bento-item--large">
        <img src={img1.src} alt="Predio Las Lunas" loading="lazy" />
        <div class="bento-overlay">
          <h3>Predio 6.000 m² de área verde</h3>
        </div>
      </article>

      <article class="bento-item bento-item--wide">
        <img src={img11.src} alt="Arboleda y pileta" loading="lazy" />
        <div class="bento-overlay">
          <h3>Arboleda y pileta</h3>
        </div>
      </article>

      <article class="bento-item bento-item--square">
        <img src={img13.src} alt="Zonas techadas" loading="lazy" />
        <div class="bento-overlay">
          <h3>Zonas techadas</h3>
        </div>
      </article>

      <article class="bento-item bento-item--square">
        <img src={img12.src} alt="Gateras ambientadas" loading="lazy" />
        <div class="bento-overlay">
          <h3>Gateras ambientadas (casitas y troncos)</h3>
        </div>
      </article>
    </div>

    <div class="location-wrapper reveal" style="transition-delay:0.2s">
      <div class="location-header">
        <span class="location-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path>
          </svg>
          Dónde encontrarnos
        </span>
      </div>

      <div class="loc-compact-grid">
        <div class="loc-compact-card">
          <img
            src={img10.src}
            alt="Predio en Pilar"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Predio en Pilar</h4>
            <a
              href="https://www.google.com/maps/place/las+lunas+hospedaje/@-34.4621712,-58.8166836,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bc99eed1e02425:0x3fffff070ad29f91!8m2!3d-34.4621712!4d-58.8166836!16s%2Fg%2F11j03_2tg3?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>

        <div class="loc-compact-card">
          <img
            src={img9.src}
            alt="Oficina atención al cliente"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Oficina atención al cliente</h4>
            <a
              href="https://www.google.com/maps/place/Las+Lunas+-+Oficina/@-34.4812534,-58.528356,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bcb1f12ef8f6d9:0xde855bf6d08d05bf!8m2!3d-34.4812534!4d-58.528356!16s%2Fg%2F11yt0tdlp7?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --green: #95bc3a; /* Verde Claro */
    --brown: #4a3f35; /* Marrón Tierra */
    --white: #ffffff;
  }

  .instalaciones {
    background: #1b4332; /* Fondo liso, sin decoraciones SVG */
    padding: 5rem 0 6rem 0;
    position: relative;
  }

  .Relative-z {
    position: relative;
    z-index: 1;
  }

  /* ── HEADER ── */
  .inst__header {
    margin-bottom: 3.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .inst__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .inst__header h2 {
    color: var(--white);
    margin-bottom: 0;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
  }
  .text-accent {
    color: var(--green);
  }

  /* ── BENTO GRID EDITORIAL ── */
  .bento-grid {
    display: grid;
    /* Dividimos en 4 columnas lógicas para jugar con los anchos */
    grid-template-columns: repeat(4, 1fr);
    /* Dos filas de altura fija (Total: 560px + gap). Ultra compacto. */
    grid-template-rows: repeat(2, 280px);
    gap: 1.25rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  .bento-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .bento-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  /* Distribución Tetris */
  .bento-item--large {
    grid-column: span 2;
    grid-row: span 2; /* Ocupa toda la altura a la izquierda */
  }
  .bento-item--wide {
    grid-column: span 2;
    grid-row: span 1; /* Ocupa el ancho restante arriba a la derecha */
  }
  .bento-item--square {
    grid-column: span 1;
    grid-row: span 1; /* Dos cuadrados abajo a la derecha */
  }

  .bento-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .bento-item:hover img {
    transform: scale(1.06);
  }

  /* Degradado oscuro para que el texto resalte siempre */
  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(27, 67, 50, 0.9) 0%,
      rgba(27, 67, 50, 0) 50%
    );
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .bento-overlay h3 {
    color: var(--white);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease;
  }

  .bento-item--large .bento-overlay h3 {
    font-size: 1.6rem; /* Título más grande para la foto principal */
  }

  .bento-item:hover .bento-overlay h3 {
    transform: translateY(-4px);
    color: var(--green);
  }

  /* ── SECCIÓN DE UBICACIÓN COMPACTA ── */
  .location-wrapper {
    max-width: 900px;
    margin: 4.5rem auto 0 auto;
    padding-top: 3.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
  }

  .location-header {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .location-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--green);
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .loc-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .loc-compact-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .loc-compact-card:hover {
    transform: translateY(-3px);
    border-color: var(--green);
  }

  .loc-compact-img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .loc-compact-info {
    display: flex;
    flex-direction: column;
  }

  .loc-compact-info h4 {
    color: var(--white);
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    line-height: 1.2;
  }

  .loc-link {
    color: var(--green);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-block;
  }

  .loc-link:hover {
    color: var(--white);
    transform: translateX(4px);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto; /* Dejamos que se adapte */
    }

    .bento-item--large,
    .bento-item--wide,
    .bento-item--square {
      grid-column: span 1;
      grid-row: span 1;
      height: 250px; /* Altura fija para tablet */
    }

    .bento-item--large {
      grid-column: span 2; /* Sigue siendo grande arriba */
      height: 350px;
    }

    .loc-compact-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .bento-item--large,
    .bento-item--wide,
    .bento-item--square {
      grid-column: span 1;
      height: 220px; /* Más bajo en celulares */
    }
  }
</style>
