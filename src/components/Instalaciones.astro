---
import img1 from "../assets/instalaciones/1.jpg";
import img2 from "../assets/instalaciones/2.jpg";
import img3 from "../assets/instalaciones/3.png";
import img4 from "../assets/instalaciones/4.png";
import img5 from "../assets/instalaciones/5.png";
import img6 from "../assets/instalaciones/6.png";
import img7 from "../assets/instalaciones/7.jpg";
import img8 from "../assets/instalaciones/8.jpg";
import img9 from "../assets/instalaciones/9.jpg";
import img10 from "../assets/instalaciones/10.jpg";

import img11 from "../assets/instalaciones/11.jpg"; // Arboleda y pileta
import img12 from "../assets/instalaciones/12.jpg"; // Gateras ambientadas
import img13 from "../assets/instalaciones/13.jpg"; // Zonas techadas
---

<section id="instalaciones" class="section instalaciones">
  <svg
    class="inst__deco"
    viewBox="0 0 1440 900"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <circle
      cx="1380"
      cy="100"
      r="200"
      fill="none"
      stroke="var(--green)"
      stroke-width="1.5"></circle>
    <circle
      cx="1380"
      cy="100"
      r="130"
      fill="none"
      stroke="var(--green)"
      stroke-width="1"></circle>
    <circle
      cx="60"
      cy="820"
      r="120"
      fill="none"
      stroke="var(--green)"
      stroke-width="1"></circle>
    <g transform="translate(1280,40) rotate(-15) scale(2)" fill="var(--green)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse>
      <ellipse cx="26" cy="4" rx="4" ry="5"></ellipse>
      <ellipse cx="39" cy="6" rx="4" ry="5"></ellipse>
      <ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse>
      <ellipse cx="30" cy="28" rx="14" ry="13"></ellipse>
    </g>
    <g transform="translate(40,750) rotate(10) scale(1.5)" fill="var(--green)">
      <ellipse cx="12" cy="6" rx="5" ry="6"></ellipse>
      <ellipse cx="26" cy="4" rx="4" ry="5"></ellipse>
      <ellipse cx="39" cy="6" rx="4" ry="5"></ellipse>
      <ellipse cx="51" cy="8" rx="3.5" ry="4.5"></ellipse>
      <ellipse cx="30" cy="28" rx="14" ry="13"></ellipse>
    </g>
  </svg>

  <div class="container Relative-z">
    <div class="inst__header reveal">
      <div class="inst__badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        NUESTRO PREDIO
      </div>
      <h2>Nuestras <span class="text-accent">Instalaciones</span></h2>
    </div>

    <div class="blocks reveal" style="transition-delay:0.1s">
      <!-- 1. Predio -->
      <div class="block block--left">
        <div class="block__photo">
          <img src={img1.src} alt="Predio Las Lunas" loading="lazy" />
        </div>
        <div class="block__text" style="border-top: 2px solid white;">
          <h3>Predio 6.000 m² de área verde</h3>
        </div>
      </div>

      <!-- 2. Arboleda y Pileta -->
      <div class="block block--right">
        <div class="block__text">
          <h3>Arboleda y pileta</h3>
        </div>
        <div class="block__photo">
          <img src={img11.src} alt="Arboleda y pileta" loading="lazy" />
        </div>
      </div>

      <!-- 3. Zonas Techadas -->
      <div class="block block--left">
        <div class="block__photo">
          <img src={img13.src} alt="Zonas techadas" loading="lazy" />
        </div>
        <div class="block__text">
          <h3>Zonas techadas</h3>
        </div>
      </div>

      <!-- 4. Gateras Ambientadas -->
      <div class="block block--right">
        <div class="block__text" style="border-bottom: 2px solid white;">
          <h3>Gateras ambientadas con casitas y troncos</h3>
        </div>
        <div class="block__photo">
          <img src={img12.src} alt="Gateras ambientadas" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- SECCIÓN DE UBICACIÓN (Diseño Compacto) -->
    <div class="location-wrapper reveal" style="transition-delay:0.2s">
      <div class="location-header">
        <span class="location-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path>
          </svg>
          Dónde encontrarnos
        </span>
      </div>

      <div class="loc-compact-grid">
        <!-- Sede Pilar -->
        <div class="loc-compact-card">
          <img
            src={img9.src}
            alt="Predio en Pilar"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Predio en Pilar</h4>
            <a
              href="https://www.google.com/maps/place/las+lunas+hospedaje/@-34.4621712,-58.8166836,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bc99eed1e02425:0x3fffff070ad29f91!8m2!3d-34.4621712!4d-58.8166836!16s%2Fg%2F11j03_2tg3?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>

        <!-- Sede Oficina -->
        <div class="loc-compact-card">
          <img
            src={img10.src}
            alt="Oficina atención al cliente"
            class="loc-compact-img"
            loading="lazy"
          />
          <div class="loc-compact-info">
            <h4>Oficina atención al cliente</h4>
            <a
              href="https://www.google.com/maps/place/Las+Lunas+-+Oficina/@-34.4812534,-58.528356,1250m/data=!3m2!1e3!4b1!4m6!3m5!1s0x95bcb1f12ef8f6d9:0xde855bf6d08d05bf!8m2!3d-34.4812534!4d-58.528356!16s%2Fg%2F11yt0tdlp7?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener"
              class="loc-link"
            >
              Cómo llegar →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA FOTOS -->
    <div class="inst__cta reveal" style="transition-delay:0.3s">
      <a href="/galeria" class="cta-fotos">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        ¡Más fotos acá!
      </a>
    </div>
  </div>
</section>

<style>
  :root {
    --green: #95bc3a; /* Verde Claro */
    --brown: #4a3f35; /* Marrón Tierra */
    --white: #ffffff;
  }

  .instalaciones {
    background: #1b4332; /* Fondo verde oscuro */
    padding: 4rem 0 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .inst__deco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .Relative-z {
    position: relative;
    z-index: 1;
  }

  /* ── HEADER ── */
  .inst__header {
    margin-bottom: 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .inst__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .inst__header h2 {
    color: var(--white);
    margin-bottom: 0.75rem;
  }
  .text-accent {
    color: var(--green);
  }

  /* ── BLOQUES ORIGINALES ── */
  .blocks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
  }

  .block {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    height: 280px;
    overflow: hidden;
  }

  .block--right {
    grid-template-columns: 1fr 1.6fr;
  }

  .block__photo {
    position: relative;
    overflow: hidden;
  }

  .block__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .block:hover .block__photo img {
    transform: scale(1.04);
  }

  .block__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 2.5rem;
    background: #1b4332;
  }

  .block--left > .block__text {
    border-right: 2px solid white;
  }

  .block--right > .block__text {
    border-left: 2px solid white;
  }

  .block__text h3 {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 900;
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 0;
    letter-spacing: -0.02em;
  }

  /* ── SECCIÓN DE UBICACIÓN COMPACTA ── */
  .location-wrapper {
    max-width: 900px;
    margin: 4rem auto 0 auto;
    padding-top: 3.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
  }

  .location-header {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .location-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--green);
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .loc-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .loc-compact-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .loc-compact-card:hover {
    transform: translateY(-3px);
    border-color: var(--green);
  }

  .loc-compact-img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .loc-compact-info {
    display: flex;
    flex-direction: column;
  }

  .loc-compact-info h4 {
    color: var(--white);
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    line-height: 1.2;
  }

  .loc-link {
    color: var(--green);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-block;
  }

  .loc-link:hover {
    color: var(--white);
    transform: translateX(4px);
  }

  /* ── CTA FOTOS ── */
  .inst__cta {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }

  .cta-fotos {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 1rem 2.5rem;
    background: var(--green);
    border-radius: 50px;
    color: var(--brown);
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(149, 188, 58, 0.3);
  }

  .cta-fotos:hover {
    background: white;
    color: var(--brown);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(255, 255, 255, 0.4);
  }

  .cta-fotos svg {
    stroke: var(--brown);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .block,
    .block--right {
      grid-template-columns: 1fr;
      grid-template-rows: 220px auto;
      height: auto;
    }

    .block--right .block__text {
      order: 2;
    }
    .block--right .block__photo {
      order: 1;
    }

    .block__text {
      padding: 1.5rem;
    }

    .loc-compact-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .block {
      grid-template-rows: 180px auto;
    }
  }
</style>
