<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Carrusel Adiestramiento
    const tSlides = document.querySelectorAll(".carousel-slide");
    const tDots = document.querySelectorAll(".carousel-dot");
    let tIndex = 0;

    if (tSlides.length > 0) {
      function goT(i: any) {
        tSlides[tIndex].classList.remove("active");
        tDots[tIndex].classList.remove("active");
        tIndex = i;
        tSlides[tIndex].classList.add("active");
        tDots[tIndex].classList.add("active");
      }
      tDots.forEach((dot, i) => {
        dot.addEventListener("click", () => goT(i));
      });
      setInterval(() => {
        goT((tIndex + 1) % tSlides.length);
      }, 3500);
    }

    // 2. Carrusel Internacional
    const iSlides = document.querySelectorAll(".int-carousel-slide");
    const iDots = document.querySelectorAll(".int-carousel-dot");
    let iIndex = 0;

    if (iSlides.length > 0) {
      function goI(i: any) {
        iSlides[iIndex].classList.remove("active");
        iDots[iIndex].classList.remove("active");
        iIndex = i;
        iSlides[iIndex].classList.add("active");
        iDots[iIndex].classList.add("active");
      }
      iDots.forEach((dot, i) => {
        dot.addEventListener("click", () => goI(i));
      });
      setInterval(() => {
        goI((iIndex + 1) % iSlides.length);
      }, 4200);
    }
  });
</script>

