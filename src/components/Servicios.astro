---
// Importar imágenes del programa de adiestramiento
import train1 from "../assets/servicios/ad 4.jpg";
import train2 from "../assets/servicios/ad 2.jpg";
import train3 from "../assets/servicios/ad 3.jpg";
import train4 from "../assets/servicios/ad 5.jpg";
import train5 from "../assets/servicios/ad 6.jpg";
import train6 from "../assets/servicios/ad 7.jpg";
import train7 from "../assets/servicios/ad 8.jpg";

import intTransport1 from "../assets/servicios/tras1.jpg";
import intTransport2 from "../assets/servicios/tras2.jpg";
import intTransport3 from "../assets/servicios/tras3.jpg";
import intTransport4 from "../assets/servicios/tras4.jpg";

// Importar logo de Latam Pet Transport
import latamLogo from "../assets/servicios/latam logo.png";

const trainingImages = [
  { src: train1.src, alt: "Adiestramiento profesional" },
  { src: train2.src, alt: "Entrenamiento canino" },
  { src: train3.src, alt: "Trabajo con adiestrador" },
  { src: train4.src, alt: "Comandos básicos" },
  { src: train5.src, alt: "Educación canina" },
  { src: train6.src, alt: "Programa intensivo de adiestramiento" },
  { src: train7.src, alt: "Perro entrenado en nuestro predio" },
];

const internationalImages = [
  { src: intTransport1.src, alt: "Traslado internacional de mascotas" },
  { src: intTransport2.src, alt: "Transporte seguro" },
  { src: intTransport3.src, alt: "Documentación internacional" },
  { src: intTransport4.src, alt: "Viaje con mascotas" },
];
---

<section id="servicios" class="section servicios">
  <div class="servicios__deco" aria-hidden="true">
    <svg class="deco-trail" viewBox="0 0 1440 2800" preserveAspectRatio="none">
      <path
        d="M-100 200 C300 50 600 600 1000 400 C1500 150 1200 1200 800 1400 C400 1600 200 2200 700 2500 C1100 2800 1300 2600 1600 2900"
      ></path>
    </svg>

    <svg
      class="deco-item deco-sparkle"
      style="top: 5%; right: 8%; width: 140px; transform: rotate(15deg);"
      viewBox="0 0 512 512"
      fill="currentColor"
    >
      <path
        d="M226.5 92.9c14.3 42.9-.3 86.2-32.6 96.8-32.8 10.8-71.5-15.6-85.8-58.5-14.3-42.9 .3-86.2 32.6-96.8 32.8-10.8 71.5 15.6 85.8 58.5zM100.4 198.6c18.9 32.4 14.3 70.1-10.2 84.1-24.8 14-60.5-1.1-79.4-33.5-18.9-32.4-14.3-70.1 10.2-84.1 24.8-14 60.4 1.1 79.4 33.5zM69.3 413.5c3.3 29.9 22.8 56.3 47.3 64 24.5 7.6 44.5-.3 41.2-30.2-3.3-29.9-22.8-56.3-47.3-64-24.5-7.7-44.5 .3-41.2 30.2zM285.5 92.9c-14.3 42.9 .3 86.2 32.6 96.8 32.8 10.8 71.5-15.6 85.8-58.5 14.3-42.9-.3-86.2-32.6-96.8-32.8-10.8-71.5 15.6-85.8 58.5zM411.6 198.6c-18.9 32.4-14.3 70.1 10.2 84.1 24.8 14 60.5-1.1 79.4-33.5 18.9-32.4 14.3-70.1-10.2-84.1-24.8-14-60.4 1.1-79.4 33.5zM442.7 413.5c-3.3 29.9-22.8 56.3-47.3 64-24.5 7.6-44.5-.3-41.2-30.2 3.3-29.9 22.8-56.3 47.3-64 24.5-7.7 44.5 .3 41.2 30.2zM319.4 333.6c-27.1-40-77.9-46.5-126.8-46.5-48.9 0-99.7 6.5-126.8 46.5-17.7 26.2-12.7 66.5 12.3 85.5 35 26.6 80.9 44.9 114.5 44.9 33.6 0 79.5-18.3 114.5-44.9 25-19 30-59.3 12.3-85.5z"
      ></path>
    </svg>

    <svg
      class="deco-item deco-bone"
      style="top: 35%; left: 4%; width: 160px; transform: rotate(-25deg);"
      viewBox="0 0 512 512"
      fill="currentColor"
    >
      <g
        transform="translate(0.000000,512.000000) scale(0.100000,-0.100000)"
        stroke="none"
      >
        <path
          d="M3430 5078 c-175 -16 -321 -87 -455 -222 -77 -77 -98 -106 -137 -186 -61 -125 -80 -208 -79 -340 1 -128 26 -236 77 -334 l35 -70 -834 -834 -834 -834 -84 45 c-430 232 -945 20 -1089 -448 -90 -294 30 -638 285 -820 134 -96 266 -138 431 -139 l112 -1 5 -130 c4 -96 10 -147 27 -195 110 -330 385 -531 723 -531 127 0 231 25 347 83 69 34 103 60 181 138 81 81 102 109 142 190 60 122 79 206 79 342 -1 148 -38 278 -116 404 l-25 40 829 829 829 829 43 -31 c210 -150 498 -184 731 -86 265 112 446 367 464 653 22 358 -213 679 -568 776 -42 12 -102 18 -175 18 l-112 1 -5 130 c-4 105 -10 145 -31 209 -115 341 -434 547 -796 514z m272 -228 c170 -64 307 -220 348 -399 17 -71 7 -228 -18 -306 -24 -73 -19 -107 20 -140 36 -30 67 -31 143 -5 248 85 534 -31 658 -267 188 -358 -51 -784 -453 -810 -154 -10 -297 41 -414 147 -61 56 -90 70 -132 63 -39 -7 -1861 -1825 -1866 -1863 -6 -37 9 -80 36 -109 40 -43 95 -142 117 -211 24 -80 26 -220 4 -304 -48 -181 -192 -330 -375 -387 -82 -25 -230 -27 -310 -3 -178 52 -315 186 -376 369 -24 73 -26 90 -21 185 3 66 13 128 26 168 24 74 20 103 -21 137 -36 30 -66 31 -140 5 -246 -86 -537 32 -661 267 -67 128 -82 260 -47 397 45 178 172 317 350 385 56 21 81 25 185 25 164 0 209 -17 394 -150 45 -32 79 -30 127 5 21 16 441 431 932 923 l892 893 0 42 c0 31 -9 54 -37 94 -109 158 -136 354 -72 523 71 192 252 335 449 355 89 8 193 -3 262 -29z"
        ></path>
        <path
          d="M2284 2831 c-89 -54 -49 -181 57 -181 45 0 89 48 89 95 0 47 -13 71 -50 90 -38 20 -58 19 -96 -4z"
        ></path>
        <path
          d="M2085 2625 c-16 -7 -141 -125 -277 -262 -235 -236 -248 -251 -248 -286 0 -49 23 -83 66 -97 27 -9 42 -9 63 0 16 6 141 125 280 264 236 238 251 255 251 289 0 26 -8 45 -27 66 -34 36 -68 44 -108 26z"
        ></path>
      </g>
    </svg>

    <svg
      class="deco-item deco-sparkle"
      style="top: 55%; right: 5%; width: 90px; transform: rotate(-10deg);"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"
      ></path>
    </svg>

    <svg
      class="deco-item deco-bone"
      style="bottom: 15%; left: 8%; width: 120px; transform: rotate(15deg);"
      viewBox="0 0 512 512"
      fill="currentColor"
    >
      <g
        transform="translate(0.000000,512.000000) scale(0.100000,-0.100000)"
        stroke="none"
      >
        <path
          d="M3430 5078 c-175 -16 -321 -87 -455 -222 -77 -77 -98 -106 -137 -186 -61 -125 -80 -208 -79 -340 1 -128 26 -236 77 -334 l35 -70 -834 -834 -834 -834 -84 45 c-430 232 -945 20 -1089 -448 -90 -294 30 -638 285 -820 134 -96 266 -138 431 -139 l112 -1 5 -130 c4 -96 10 -147 27 -195 110 -330 385 -531 723 -531 127 0 231 25 347 83 69 34 103 60 181 138 81 81 102 109 142 190 60 122 79 206 79 342 -1 148 -38 278 -116 404 l-25 40 829 829 829 829 43 -31 c210 -150 498 -184 731 -86 265 112 446 367 464 653 22 358 -213 679 -568 776 -42 12 -102 18 -175 18 l-112 1 -5 130 c-4 105 -10 145 -31 209 -115 341 -434 547 -796 514z m272 -228 c170 -64 307 -220 348 -399 17 -71 7 -228 -18 -306 -24 -73 -19 -107 20 -140 36 -30 67 -31 143 -5 248 85 534 -31 658 -267 188 -358 -51 -784 -453 -810 -154 -10 -297 41 -414 147 -61 56 -90 70 -132 63 -39 -7 -1861 -1825 -1866 -1863 -6 -37 9 -80 36 -109 40 -43 95 -142 117 -211 24 -80 26 -220 4 -304 -48 -181 -192 -330 -375 -387 -82 -25 -230 -27 -310 -3 -178 52 -315 186 -376 369 -24 73 -26 90 -21 185 3 66 13 128 26 168 24 74 20 103 -21 137 -36 30 -66 31 -140 5 -246 -86 -537 32 -661 267 -67 128 -82 260 -47 397 45 178 172 317 350 385 56 21 81 25 185 25 164 0 209 -17 394 -150 45 -32 79 -30 127 5 21 16 441 431 932 923 l892 893 0 42 c0 31 -9 54 -37 94 -109 158 -136 354 -72 523 71 192 252 335 449 355 89 8 193 -3 262 -29z"
        ></path>
        <path
          d="M2284 2831 c-89 -54 -49 -181 57 -181 45 0 89 48 89 95 0 47 -13 71 -50 90 -38 20 -58 19 -96 -4z"
        ></path>
        <path
          d="M2085 2625 c-16 -7 -141 -125 -277 -262 -235 -236 -248 -251 -248 -286 0 -49 23 -83 66 -97 27 -9 42 -9 63 0 16 6 141 125 280 264 236 238 251 255 251 289 0 26 -8 45 -27 66 -34 36 -68 44 -108 26z"
        ></path>
      </g>
    </svg>
  </div>

  <div class="container Relative-z">
    <div class="servicios__header reveal">
      <div class="header-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          ></path>
        </svg>
        <span>LO QUE OFRECEMOS</span>
      </div>

      <div class="header-two-col">
        <div class="header-left">
          <h2>Nuestros <span class="text-accent">servicios</span></h2>
          <p class="header-body">
            Todo lo que necesita tu mascota en un entorno seguro, natural y
            profesional.
          </p>
        </div>
      </div>
    </div>

    <div class="services-bento-grid">
      <article
        class="bento-service card-brown reveal"
        style="transition-delay: 0.1s;"
      >
        <div class="service-content">
          <div class="service-header-row">
            <div class="service-number card-a-number">01</div>
            <div class="stat-icon brown-icon">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M12 5c2 0 4 2 4 4v2h2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h2V9c0-2 2-4 4-4z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="service-title" style="color: var(--green);">
            Hospedaje para perros
          </h3>
          <p class="service-description" style="color: var(--off-white);">
            Perros en libertad en grupos homogéneos, siempre supervisados.
            Descanso cómodo y seguro por la noche.
          </p>
          <a href="#contacto" class="service-cta card-a-btn">
            <span>Consultar</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
              ><path
                d="M4 10H16M16 10L10 4M16 10L10 16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path></svg
            >
          </a>
        </div>
      </article>

      <article
        class="bento-service card-green reveal"
        style="transition-delay: 0.2s;"
      >
        <div class="service-content">
          <div class="service-header-row">
            <div class="service-number card-b-number">02</div>
            <div class="stat-icon green-icon">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="service-title" style="color: var(--brown);">
            Hospedaje para gatos
          </h3>
          <p class="service-description" style="color: var(--brown);">
            Gateras amplias e individuales, ambientadas con troncos, plantas y
            casitas para que se sientan en casa.
          </p>
          <a href="#contacto" class="service-cta card-b-btn">
            <span>Consultar</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
              ><path
                d="M4 10H16M16 10L10 4M16 10L10 16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path></svg
            >
          </a>
        </div>
      </article>

      <article
        class="bento-service card-white reveal"
        style="transition-delay: 0.3s;"
      >
        <div class="service-content">
          <div class="service-header-row">
            <div class="service-number card-c-number">03</div>
            <div class="stat-icon outline-icon">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="1" y="3" width="15" height="13"></rect><polygon
                  points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle
                  cx="5.5"
                  cy="18.5"
                  r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
          </div>
          <h3 class="service-title text-dark">Traslados a domicilio</h3>
          <p class="service-description">
            Retiro y devolución con camionetas acondicionadas y personal
            capacitado.
          </p>
          <div class="service-meta-mini">
            <span>Lun a Vie: 8:00 - 16:00 hs</span>
            <a href="/requisitos" target="_blank" class="meta-link"
              >Requisitos sanitarios →</a
            >
          </div>
          <a href="#contacto" class="service-cta card-c-btn">
            <span>Consultar</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
              ><path
                d="M4 10H16M16 10L10 4M16 10L10 16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path></svg
            >
          </a>
        </div>
      </article>
    </div>

    <div
      class="training-full-width card-brown reveal"
      style="transition-delay: 0.4s;"
    >
      <div class="training-content-area">
        <span class="training-badge">Programa Intensivo</span>
        <h3 class="training-title">Programas de adiestramiento</h3>

        <div class="training-main-layout">
          <div class="training-left-column">
            <div class="training-section">
              <h4 class="section-title-small">¿En qué consiste?</h4>
              <p class="section-text">
                Su perro estará hospedado con nosotros 30 días corridos, donde
                trabajará diariamente con el adiestrador.
              </p>
            </div>

            <div class="training-section">
              <h4 class="section-title-small">¿Qué incluye?</h4>
              <ul class="includes-list">
                <li>Hospedaje por 30 días.</li>
                <li>
                  Traslados incluidos: retiro y devolución a tu domicilio.
                </li>
                <li>Alimento premium durante toda la estadía.</li>
                <li>Baños sanitarios.</li>
                <li>Asistencia veterinaria permanente.</li>
                <li>Informe de avances e instructivo final.</li>
              </ul>
            </div>

            <div class="training-section">
              <h4 class="section-title-small">
                ¿Qué logrará con este programa?
              </h4>
              <div class="table-responsive">
                <table class="commands-table">
                  <tbody>
                    <tr
                      ><td class="cmd-name">Junto</td><td
                        >Camina junto al guía.</td
                      ></tr
                    >
                    <tr
                      ><td class="cmd-name">Sit / Down</td><td
                        >Se sienta / Se echa.</td
                      ></tr
                    >
                    <tr
                      ><td class="cmd-name">Stá o parado</td><td>Se para.</td
                      ></tr
                    >
                    <tr
                      ><td class="cmd-name">Vení</td><td
                        >Acude al llamado siempre.</td
                      ></tr
                    >
                    <tr
                      ><td class="cmd-name">Varía pos.</td><td
                        >Se queda en las posiciones aprendidas.</td
                      ></tr
                    >
                    <tr
                      ><td class="cmd-name">Off</td><td
                        >Aprende a no saltar sobre la gente.</td
                      ></tr
                    >
                  </tbody>
                </table>
              </div>
            </div>

            <div class="training-section guarantee-box-wrapper">
              <div class="guarantee-box guarantee-accent">
                <div class="guarantee-header">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    ><path
                      d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                    ></path></svg
                  >
                  <h5 class="guarantee-title">Garantía de 3 meses</h5>
                </div>
                <div class="guarantee-content">
                  <p>
                    Garantizamos el correcto funcionamiento de los comandos. Si
                    alguno falla, lo reforzamos en nuestro predio.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="training-right-gallery">
            <div class="gallery-grid-integrated">
              {
                trainingImages.map((img, index) => (
                  <div class={`gallery-item gallery-item-${index + 1}`}>
                    <img src={img.src} alt={img.alt} loading="lazy" />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="international-transport-card reveal"
      style="transition-delay: 0.5s;"
    >
      <div class="international-header">
        <div class="int-header-left">
          <a
            href="https://www.latampettransport.com/es/"
            target="_blank"
            class="latam-logo-container"
          >
            <img
              src={latamLogo.src}
              alt="Latam Pet Transport"
              class="latam-logo"
            />
          </a>
          <span class="partner-badge">Partner Oficial</span>
        </div>
        <div class="int-header-icon">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
            ></path></svg
          >
        </div>
      </div>

      <div class="international-content-new">
        <div class="int-text-main">
          <h3 class="int-title-large">Traslado internacional de mascotas</h3>
          <p class="int-subtitle">¿Viajás con tu mascota?</p>
          <p class="int-description">
            Te acompañamos paso a paso para organizar su traslado internacional
            de forma segura y profesional.
          </p>
          <a
            href="https://www.latampettransport.com/es/quote/"
            target="_blank"
            class="btn-quote-international"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            <span>Solicitar cotización</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              ><path
                d="M1 8H15M15 8L8 1M15 8L8 15"
                stroke="currentColor"
                stroke-width="2"></path></svg
            >
          </a>
        </div>

        <div class="int-gallery-mosaic">
          {
            internationalImages.map((img, index) => (
              <div class={`mosaic-img mosaic-img-${index + 1}`}>
                <img src={img.src} alt={img.alt} loading="lazy" />
                <div class="mosaic-overlay" />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="general-services-card-new reveal"
      style="transition-delay: 0.6s;"
    >
      <div class="general-header-new">
        <h3 class="general-title-main">Servicios incluidos</h3>
        <p class="general-subtitle">Cuidado integral para tu mascota</p>
      </div>

      <div class="general-grid-new">
        <div class="general-card-item supervision-card">
          <div class="general-card-icon">
            <svg
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
              ></path><circle cx="12" cy="12" r="3"></circle></svg
            >
          </div>
          <h4 class="general-card-title">Supervisión permanente</h4>
          <p class="general-card-desc">Monitoreo continuo 24/7</p>
        </div>

        <div class="general-card-item cleaning-card">
          <div class="general-card-icon">
            <svg
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"
              ></path></svg
            >
          </div>
          <h4 class="general-card-title">Limpieza constante</h4>
          <p class="general-card-desc">Higiene y desinfección diaria</p>
        </div>

        <div class="general-card-item bath-card">
          <div class="general-card-icon">
            <svg
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg
            >
          </div>
          <h4 class="general-card-title">Baños sanitarios</h4>
          <p class="general-card-desc">Cuidado estético profesional</p>
        </div>

        <div class="general-card-item vet-card featured-card">
          <div class="featured-content">
            <div class="featured-left">
              <div class="general-card-icon featured-icon">
                <svg
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
                >
              </div>
              <div class="featured-text">
                <h4 class="general-card-title">Asistencia veterinaria</h4>
                <p class="general-card-desc">
                  Atención profesional ante urgencias
                </p>
              </div>
            </div>
            <div class="featured-badge">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path
